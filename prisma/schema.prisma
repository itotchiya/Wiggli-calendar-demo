// Wiggli Calendar Demo — data model
// Event ↔ Attendee (1:N). Attendee carries the live RSVP status.
// RsvpTokenLog indexes by one-click token so /api/rsvp can resolve (event, attendee)
// without leaking internal IDs.

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model Event {
  id             String   @id @default(cuid())
  googleEventId  String? // Google Calendar event ID, set after events.insert
  source         String   @default("WIGGLI") // WIGGLI-created event or imported GOOGLE event
  iCalUID        String   @unique // shared between GCal event & our .ics attachment
  summary        String
  eventType      String?
  description    String?
  location       String?
  start          DateTime
  end            DateTime
  timezone       String
  emailSubject   String?
  emailHtml      String? // custom HTML body overriding the default branded template
  organizerEmail String
  sequence       Int      @default(0) // ICS SEQUENCE — bumped on each re-send/update
  status         String   @default("SCHEDULED") // SCHEDULED | CANCELLED — local mirror of Google event status
  /** ISO datetime of the latest accepted reschedule (null = never rescheduled). */
  rescheduledAt  DateTime?
  /** Organizer note included with the last "update & notify" reschedule. */
  rescheduleNote String?
  hangoutLink    String? // real Google Meet URL when a conference was provisioned
  reminderMinutes Int? // null = calendar default; stored for email rendering
  previewData     Json? // organizer profile, avatars, linked records, locations, meeting links
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  attendees Attendee[]
  proposals EventProposal[]
  note      MeetingNote?

  @@index([googleEventId])
  @@index([source])
}

/** A "Propose a new time" counter-proposal detected from the organizer's Gmail. */
model EventProposal {
  id            String   @id @default(cuid())
  eventId       String
  attendeeEmail String
  /** Human-readable proposed slot as Google stated it, e.g. "Tue 2 Sep 2026, 14:00 – 14:30". */
  slotLabel     String
  /** Optional note the attendee added to the proposal. */
  note          String?
  /** gmail-notification | manual (future in-app proposals) */
  source        String   @default("gmail-notification")
  status        String   @default("PENDING") // PENDING | ACCEPTED | DISMISSED
  createdAt     DateTime @default(now())

  event Event @relation(fields: [eventId], references: [id], onDelete: Cascade)

  @@index([eventId])
}

model Attendee {
  id          String    @id @default(cuid())
  eventId     String
  email       String
  name        String?
  type        String? // drawer attendee type: candidate | contact | internal
  rsvp        String    @default("NEEDS_ACTION") // NEEDS_ACTION | ACCEPTED | TENTATIVE | DECLINED
  comment     String? // Optional response comment from Google Calendar
  respondedAt DateTime?

  event Event @relation(fields: [eventId], references: [id], onDelete: Cascade)

  @@unique([eventId, email])
}

model OrganizerAccount {
  id            String   @id @default(cuid())
  email         String   @unique
  refreshToken  String? // Google OAuth refresh token for offline RSVP sync
  calendarAlias String?  @unique // stable Resend inbound organizer address
  createdAt     DateTime @default(now())
}

model RsvpTokenLog {
  id            String   @id @default(cuid())
  token         String // signed per-(event,attendee) token — NOT unique:
  // attendees may legitimately change their RSVP by clicking again,
  // so the audit log records every click.
  eventId       String
  attendeeEmail String
  action        String // yes | maybe | no
  dedupeKey     String?  @unique // inbound source key, e.g. gmail:<message-id>
  receivedAt    DateTime @default(now())

  @@index([eventId, attendeeEmail])
  @@index([token])
}

/** AI Notetaker — one row per event with the toggle on. The row's existence IS the toggle. */
model MeetingNote {
  id            String   @id @default(cuid())
  eventId       String   @unique
  event         Event    @relation(fields: [eventId], references: [id], onDelete: Cascade)

  // lifecycle: CREATED → JOINING → RECORDING → TRANSCRIBED → PROCESSING → READY | FAILED
  status        String   @default("CREATED")
  statusMessage String? // error detail when FAILED; last bot subcode otherwise

  // capture source: MANUAL_PASTE | AUDIO_UPLOAD | RECALL_BOT
  source        String   @default("RECALL_BOT")
  recallBotId   String?
  recallRecordingId String?
  recallRecordingUrl String?

  transcriptText String? // full transcript (speakers + [mm:ss] lines)
  transcriptJson Json? // [{speaker, time, text}] when parseable

  // ONE Gemini structured-output call, stored raw + parsed:
  aiRaw        Json? // verbatim Gemini JSON
  summary      Json? // {overview, experience[], skills[], ...} per event-type template
  templateUsed String? // eventType → template name

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  insights Insight[]
  actions  NoteAction[]

  @@index([status])
  @@index([recallBotId])
}

/** One structured fact extracted from the transcript (Spott-style suggest → review). */
model Insight {
  id        String      @id @default(cuid())
  noteId    String
  note      MeetingNote @relation(fields: [noteId], references: [id], onDelete: Cascade)

  field      String // notice_period | salary_expectation | availability | skill | ...
  value      String
  confidence Float?
  speaker    String? // candidate | interviewer | unknown
  timestamp  String? // "00:21:14"
  evidence   String? // exact transcript quote
  // review: PENDING → ACCEPTED | IGNORED
  reviewStatus String @default("PENDING")

  @@index([noteId, reviewStatus])
}

/** One suggested follow-up extracted from the transcript. */
model NoteAction {
  id        String      @id @default(cuid())
  noteId    String
  note      MeetingNote @relation(fields: [noteId], references: [id], onDelete: Cascade)

  title      String
  owner      String? // organizer | candidate | contact
  dueDate    String?
  timestamp  String?
  evidence   String?
  // review: PENDING → CREATED_TASK | IGNORED
  reviewStatus String @default("PENDING")

  @@index([noteId, reviewStatus])
}
