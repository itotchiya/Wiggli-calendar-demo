# ── Database (Prisma + PostgreSQL) ───────────────────────────────────────────
# Runtime URL: use the provider's pooled connection string on Vercel.
DATABASE_URL="postgresql://user:password@host-pooler:5432/wiggli?sslmode=require"
# Migration URL: use the provider's direct/non-pooling connection string.
# If your provider gives only one URL, set DIRECT_URL to the same value.
DIRECT_URL="postgresql://user:password@host:5432/wiggli?sslmode=require"

# ── Google Cloud OAuth app ──────────────────────────────────────────────────
# 1. https://console.cloud.google.com/apis/credentials → Create OAuth client ID
# 2. Enable "Google Calendar API" and "Gmail API" for the project
# 3. Authorized redirect URI (match YOUR port — this demo runs on 3100):
#      http://localhost:3100/api/auth/callback/google
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# ── Auth.js session secret ──────────────────────────────────────────────────
# Generate with: openssl rand -base64 32
AUTH_SECRET=""

# ── Public base URL (used to build RSVP links inside invite emails) ─────────
# Must be reachable from attendees' devices — localhost only works for demos.
NEXT_PUBLIC_APP_URL="http://localhost:3100"

# Google Gemini (AI invitation drafting)
GEMINI_API_KEY=""

# ── Resend RSVP invitations ─────────────────────────────────────────────────
# Use a dedicated verified subdomain (for example events.example.com) with
# SPF/DKIM/DMARC for sending and Resend's MX record for inbound METHOD:REPLY.
# Never commit a real API key. Rotate any key pasted into a chat or ticket.
RESEND_API_KEY=""
RESEND_CALENDAR_DOMAIN="events.example.com"
RESEND_FROM_NAME="Wiggli Calendar"
RESEND_WEBHOOK_SECRET=""
