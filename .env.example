# ── Database (Prisma + SQLite) ────────────────────────────────────────────────
DATABASE_URL="file:./prisma/dev.db"

# ── Google Cloud OAuth app ──────────────────────────────────────────────────
# 1. https://console.cloud.google.com/apis/credentials → Create OAuth client ID
# 2. Enable "Google Calendar API" and "Gmail API" for the project
# 3. Authorized redirect URI (match YOUR port — this demo runs on 3100):
#      http://localhost:3100/api/auth/callback/google
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# ── Auth.js session secret ──────────────────────────────────────────────────
# Generate with: openssl rand -base64 32
AUTH_SECRET=""

# ── Public base URL (used to build RSVP links inside invite emails) ─────────
# Must be reachable from attendees' devices — localhost only works for demos.
NEXT_PUBLIC_APP_URL="http://localhost:3100"

# Google Gemini (AI invitation drafting)
GEMINI_API_KEY=""
